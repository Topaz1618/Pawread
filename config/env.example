# Pawread configuration
#
# Copy this file to `config/env.local` and fill in your own values.
# `config/env.local` is loaded automatically at startup; any variable that is
# already set in your shell takes precedence over the value in this file.
#
# Leave a value empty to fall back to the built-in default. Empty values never
# override a default.
#
# Never commit a filled-in copy. `config/env.local` is listed in .gitignore.

# ---------------------------------------------------------------------------
# Web server
# ---------------------------------------------------------------------------
# The address and port the web UI binds to. Set these to match your
# deployment. Leaving them empty binds to the loopback interface on the
# built-in default port.
PAWREAD_HOST=
PAWREAD_PORT=

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
# API key for the model provider. Required.
DASHSCOPE_API_KEY=

# ---------------------------------------------------------------------------
# Proxy
# ---------------------------------------------------------------------------
# Downloads go through a residential proxy. Without one, most supported sites
# refuse connections from a datacenter IP. Required.
SMARTPROXY_ACCOUNT=
SMARTPROXY_PASSWORD=

# Gateway settings. Leave empty to use the built-in defaults.
SMARTPROXY_HOST=
SMARTPROXY_PORT=
SMARTPROXY_AREA=
SMARTPROXY_LIFE=
